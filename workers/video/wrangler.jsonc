{
  // MyFit lesson video API (see docs/R2_VIDEO.md).
  // Secrets are NOT stored here; set them with `wrangler secret put`:
  //   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, FIREBASE_SERVICE_ACCOUNT,
  //   DEVSMS_API_TOKEN (optional, SMS sign-in), CALORIE_API_KEY (optional, food lookup)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myfit-video",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "VIDEOS", "bucket_name": "myfit-videos" }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "myfit-d6275",
    "R2_ENDPOINT": "https://7d6c72f2d7ccf971e52c251086f2bfa1.r2.cloudflarestorage.com",
    "R2_BUCKET": "myfit-videos",
    // Switch to a custom domain later (new uploads only).
    "R2_PUBLIC_BASE_URL": "https://pub-32dc4a48be774882aaf3dd1d07697a5b.r2.dev",
    // Browser origins allowed to call the API (mobile apps need no CORS).
    "ALLOWED_ORIGINS": "https://myfit-d6275.web.app,https://myfit-d6275.firebaseapp.com",
    // SMS sign-in template (DevSMS). Empty = DevSMS universal OTP.
    // Set the template ID you choose from the "List DevSMS templates" workflow.
    // 564 = "Ilovaga kirish" (owner's approved template).
    "DEVSMS_OTP_TEMPLATE_ID": "564",
    // Token or literal example code that receives the code (auto if one token).
    // Template 564 shows the example code 583921; it is replaced by the real code.
    "DEVSMS_OTP_CODE_PLACEHOLDER": "583921",
    // JSON with fixed values for other tokens, e.g. {"{app}":"MyFit"}.
    "DEVSMS_OTP_TEMPLATE_VALUES": "",
    // Sender name registered in DevSMS (empty = DevSMS default).
    "DEVSMS_FROM": ""
  }
}
